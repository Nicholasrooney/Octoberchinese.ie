# October Chinese Dining

# Serve the generated sitemap at the conventional address.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# index.php is the front page.
DirectoryIndex index.php index.html

# Don't advertise the directory listing of folders without an index.
Options -Indexes

<IfModule mod_headers.c>
    # Basic hardening. No CSP here yet: once the visitor allows it the site
    # loads Google Analytics and a Google Maps iframe. Fonts are self-hosted.
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>

# Let the browser cache the assets that carry a long life anyway.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/png  "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType text/css   "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml
</IfModule>
